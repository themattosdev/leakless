{
    "name": "themattosdev/leakless-dev",
    "description": "Developer tooling, PHPStan AST rules, and Pest assertions for Leakless",
    "keywords": [
        "frankenphp",
        "octane",
        "phpstan",
        "pest",
        "testing",
        "leakless"
    ],
    "homepage": "https://github.com/themattosdev/leakless",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonathan Gonçalves",
            "email": "jonathan@themattos.dev",
            "homepage": "https://themattos.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "themattosdev/leakless": "^0.5 || ^0.6 || ^0.7 || *@dev",
        "nikic/php-parser": "^5.0",
        "nunomaduro/termwind": "^2.0",
        "phpstan/phpstan": "^2.0",
        "symfony/console": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "TheMattos\\Leakless\\Dev\\": "src/"
        },
        "files": [
            "src/Pest/Autoload.php"
        ]
    },
    "bin": [
        "bin/leakless"
    ],
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
