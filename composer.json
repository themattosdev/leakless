{
    "name": "themattosdev/leakless",
    "description": "Zero state and memory leak prevention for PHP persistent runtimes (FrankenPHP & Laravel Octane)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonathan Gonçalves",
            "email": "jonathan@themattos.dev",
            "homepage": "https://themattos.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pcntl": "*",
        "ext-posix": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "nunomaduro/phpinsights": "^2.14",
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "phpstan/phpstan": "^2.0",
        "themattosdev/leakless-dev": "*@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/dev",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "TheMattos\\Leakless\\": "packages/runtime/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Architecture\\": "tests/Architecture/",
            "Tests\\Fixtures\\": "tests/Fixtures/",
            "Tests\\Integration\\": "tests/Integration/",
            "Tests\\Unit\\": "tests/Unit/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TheMattos\\Leakless\\Integrations\\Laravel\\LeaklessServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage --min=100",
        "lint": "vendor/bin/pint --test",
        "lint:fix": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
